{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rallyroo-site",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "rallyroo.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.rallyroo.dev",
      "custom_domain": true
    }
  ]
}
