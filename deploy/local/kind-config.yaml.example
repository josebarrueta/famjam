# deploy-local.sh generates the real config with an absolute host data path.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
  - role: control-plane
    extraPortMappings:
      - containerPort: 30080
        hostPort: 8080
        listenAddress: 127.0.0.1
        protocol: TCP
    extraMounts:
      - hostPath: /absolute/path/to/.rallyroo/data
        containerPath: /var/local/rallyroo
